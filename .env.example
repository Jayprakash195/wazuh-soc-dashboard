# Copy to .env (never commit .env). Placeholders only.
WAZUH_API_URL=https://192.168.21.138:55000
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=
# Alerts live in the Wazuh Indexer, not the manager API
WAZUH_INDEXER_URL=https://192.168.21.138:9200
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=
# true, or a path to a CA cert. "false" only for the isolated lab (self-signed cert => MITM risk)
WAZUH_VERIFY_TLS=true
